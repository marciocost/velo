# Pipeline com testes unitários, Preview isolado, testes E2E e deploy de produção.
name: Continuous Deployment

on:
  push:
    branches:
      - main

env:
  NODE_VERSION: '24'
  VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
  VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
  VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
  VERCEL_SCOPE: marcio-costa1
  PREVIEW_SUPABASE_PROJECT_ID: htqzbjfjpvfossfrjtao

jobs:
  unit-tests:
    name: Unit Tests
    runs-on: ubuntu-latest
    steps:
      # Faz o checkout do código-fonte.
      - name: Checkout repository
        uses: actions/checkout@v4

      # Configura o Node.js e as dependências.
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}

      - name: Enable Corepack
        run: corepack enable

      - name: Install dependencies
        run: yarn install

      # Executa os testes unitários.
      - name: Run unit tests
        run: yarn test

  build-and-deploy:
    name: Build & Deploy Vercel Preview
    needs: unit-tests
    runs-on: ubuntu-latest
    outputs:
      deployment_url: ${{ steps.deploy.outputs.deployment_url }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}

      - name: Enable Corepack
        run: corepack enable

      - name: Install dependencies
        run: yarn install

      - name: Verify Vercel authentication
        run: yarn vercel whoami --token=$VERCEL_TOKEN

      # Obtém as configurações do ambiente Preview.
      - name: Vercel Pull
        run: yarn vercel pull --yes --environment=preview --token=$VERCEL_TOKEN --scope=$VERCEL_SCOPE

      # Interrompe o pipeline se o Preview estiver configurado com outro Supabase.
      - name: Validate Preview Supabase
        run: |
          node <<'NODE'
          const fs = require('node:fs')
          const { parseEnv } = require('node:util')
          const vars = parseEnv(fs.readFileSync('.vercel/.env.preview.local', 'utf8'))
          const ref = process.env.PREVIEW_SUPABASE_PROJECT_ID
          if (
            vars.VITE_SUPABASE_URL !== `https://${ref}.supabase.co` ||
            vars.VITE_SUPABASE_PROJECT_ID !== ref ||
            !vars.VITE_SUPABASE_PUBLISHABLE_KEY
          ) {
            throw new Error('As variáveis de Preview não apontam para o Supabase Preview!')
          }
          console.log('Supabase Preview validado.')
          NODE

      # Compila o frontend com as variáveis Preview.
      - name: Vercel Build
        run: yarn vercel build --token=$VERCEL_TOKEN --scope=$VERCEL_SCOPE

      # Publica o Preview e disponibiliza a URL para os testes E2E.
      - name: Deploy Preview
        id: deploy
        run: |